generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String?
  password    String
  isAdmin     Boolean  @default(false)
  todos       Todo[]
  createdTodos Todo[]   @relation("TodoCreatedBy")
  assignedTodos Todo[]  @relation("TodoAssignedTo")
  projects    Project[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Todo {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  completed   Boolean  @default(false)
  dueDate     DateTime? // 完了予定日
  completedAt DateTime? // 完了日時
  userId      Int?
  createdById Int?
  assignedToId Int?
  projectId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
  createdBy   User?    @relation("TodoCreatedBy", fields: [createdById], references: [id])
  assignedTo  User?    @relation("TodoAssignedTo", fields: [assignedToId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id])
  labels      TodoLabel[]
}

model Label {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  color     String      // 色コード（例: "blue", "red", "green"など）
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  todos     TodoLabel[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  color       String   @default("blue")
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])
  todos       Todo[]
}

model TodoLabel {
  todoId  Int
  labelId Int
  todo    Todo  @relation(fields: [todoId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([todoId, labelId])
}
